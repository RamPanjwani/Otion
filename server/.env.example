PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/otion
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173
# Comma-separated production/staging origins. When set, this takes precedence over CLIENT_URL.
CLIENT_URLS=http://localhost:5173
# Optional isolated database used by integration tests.
TEST_MONGO_URI=mongodb://127.0.0.1:27017/otion_test

# Rate-limit ceilings per 15 minutes. Defaults (500 API / 30 auth) are the production values;
# raise them on a throwaway target when running npm run loadtest, or the limiter is measured.
# API_RATE_LIMIT=5000
# AUTH_RATE_LIMIT=500

# Optional error tracking (Sentry). Leave blank and nothing is reported.
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=otion-api@1.0.0
# SENTRY_TRACES_SAMPLE_RATE=0

# Email Delivery (Resend API)
# RESEND_API_KEY=re_123456789
# RESEND_FROM_EMAIL=Otion <onboarding@resend.dev>

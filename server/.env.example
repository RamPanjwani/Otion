PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/otion
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173
# Comma-separated production/staging origins. When set, this takes precedence over CLIENT_URL.
CLIENT_URLS=http://localhost:5173
# Optional isolated database used by integration tests.
TEST_MONGO_URI=mongodb://127.0.0.1:27017/otion_test

# Optional error tracking (Sentry). Leave blank and nothing is reported.
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=otion-api@1.0.0
# SENTRY_TRACES_SAMPLE_RATE=0
